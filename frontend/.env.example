# 复制为 .env.local 并填入真实值（.env.local 不入库）。
#
# 命名规则：**不要**加 VITE_ 前缀。带 VITE_ 的变量会被 Vite 静态替换进浏览器
# 产物体内，等于把密钥发给每一个访问者。这里的密钥只在 Node 侧使用：
# vite.config.ts 的 minimax-tts-proxy 插件读取后，由中间件代发 Authorization 头。

# MiniMax 开放平台 API Key
MINIMAX_API_KEY=

# MiniMax GroupId（语音合成 URL 的 GroupId 参数）
MINIMAX_GROUP_ID=

# 可选：上游地址与本地路由，一般无需改动
# MINIMAX_TTS_ENDPOINT=https://api.minimax.chat/v1/t2a_v2
# MINIMAX_TTS_ROUTE=/api/tts

# ---------------------------------------------------------------- #
# Dify 对话凭据 —— 同样**只**在 Node 侧（vite dev / preview 中间件）读取。
#
# 来源：仓库根 AI对接.xlsx。**一个「使用阶段」一个 Dify 应用，因而一把密钥**，
# 前端按 `/api/dify/<阶段>` 选路，中间件据此挑密钥。四个应用实测都是聊天 /
# Chatflow 型，统一走 POST {DIFY_API_BASE}/chat-messages。
#
# ⚠️ 变量名**不带 VITE_ 前缀**：带前缀会被 Vite 静态替换进浏览器产物，
#    等于把 app-* 密钥发给每一个访客。浏览器只向同源 /api/dify/<阶段> 发纯 JSON，
#    Authorization 头由中间件在 Node 侧补上。
#
# 只填要用的阶段即可；没填的阶段被调用时会回 not_configured，不影响其余阶段。
# （01 也接受旧的 DIFY_API_KEY，兼容上一版单应用的配置。）
# ---------------------------------------------------------------- #

DIFY_API_BASE=http://line.doctoru.net/v1

# 使用阶段 01 知识宣教            → 已接入 KnowledgePage 底部 AI 导师对话栏
DIFY_API_KEY_01=
# 使用阶段 02 流行病学调查_1      → 待接入
DIFY_API_KEY_02=
# 使用阶段 03 流行病学调查_1      → 待接入
DIFY_API_KEY_03=
# 使用阶段 04 结案报告            → 待接入
DIFY_API_KEY_04=

# 可选：本地路由与上游超时，一般无需改动
# DIFY_ROUTE=/api/dify
# DIFY_TIMEOUT_MS=60000
